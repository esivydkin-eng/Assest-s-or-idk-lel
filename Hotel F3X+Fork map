local wave,tier={},nil
local function flush()
 local left=0
 local boxes,tags={},{}
 for _,g in ipairs(wave) do
  local mems={}
  for _,id in ipairs(g[3]) do local p=P[id] if p then mems[#mems+1]=p end end
  if #mems>0 then
   left+=1
   task.spawn(function()
    local box=call("CreateGroup",g[1],workspace,mems)
    if box then boxes[#boxes+1]=box tags[#tags+1]=g[2] end
    left-=1
   end)
  end
 end
 while left>0 do task.wait() end
 for i=1,#boxes,BURST do
  local a,b={},{}
  for j=i,math.min(i+BURST-1,#boxes) do a[#a+1]=boxes[j] b[#b+1]=tags[j] end
  call("SetName",a,b)
 end
 wave={}
end
for _,g in ipairs(GRP) do
 if tier and g[4]~=tier then flush() end
 tier=g[4]
 wave[#wave+1]=g
end
flush()

