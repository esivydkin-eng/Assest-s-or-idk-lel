MAKE[#MAKE+1]=function() burst(bump,function(b) call("SyncCollision",b) end) end
MAKE[#MAKE+1]=function() burst(lock,function(b) call("SyncAnchor",b) end) end
MAKE[#MAKE+1]=function()
 local left=0
 for i=1,#tags,BURST do
  local a,b={},{}
  for j=i,math.min(i+BURST-1,#tags) do a[#a+1]=tags[j] b[#b+1]=named[j] end
  left+=1
  task.spawn(function() call("SetName",a,b) left-=1 end)
 end
 while left>0 do task.wait() end
end

