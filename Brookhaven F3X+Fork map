  call("SetName",a,b)
 end
 wave={}
end
for _,g in ipairs(GRP) do
 if tier and g[4]~=tier then flush() end
 tier=g[4]
 wave[#wave+1]=g
end
flush()

if #move>0 then
 burst(move,function(b) call("SyncMove",b) end)
end

local heads={}
for _,plr in ipairs(Players:GetPlayers()) do
 local ch=plr.Character
 local hd=ch and ch:FindFirstChild("Head")
 if hd then heads[#heads+1]=hd end
end
if #heads>0 then call("Remove",heads) end

