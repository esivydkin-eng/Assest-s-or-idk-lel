  coat[#coat+1]={Part=p,Material=MT[d[5]],Transparency=d[6],Reflectance=d[7]}
  bump[#bump+1]={Part=p,CanCollide=d[8]}
  lock[#lock+1]={Part=p,Anchored=d[9]}
  if d[10]>0 then tags[#tags+1]=p named[#named+1]=NM[d[10]] end
 end
end
