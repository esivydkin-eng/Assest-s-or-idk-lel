  shells[#shells+1]={Part=p}
  skins[#skins+1]={Part=p,MeshType=Enum.MeshType[m[2]],MeshId=m[3],TextureId=m[4],Scale=m[5],Offset=m[6],VertexColor=m[7]}
  if m[8] then solid[#solid+1]=m[1] end
 end
end
burst(shells,function(b) call("CreateMeshes",b) end)
burst(skins,function(b) call("SyncMesh",b) end)
if FORKEP and #solid>0 then
 local function key(v) return math.floor(v.X*100)..","..math.floor(v.Y*100)..","..math.floor(v.Z*100) end
 local spot,park,kept={},{},{}
 for k,id in ipairs(solid) do
  local p=P[id]
  if p then
   local col=(k-1)%64
   local row=((k-1)//64)%64
   local lay=(k-1)//4096
   local at=STAGE*CF(col*6-189,lay*7,row*6-189)
   spot[key(at.Position)]=id
   park[#park+1]={Part=p,CFrame=at}
   kept[#kept+1]=id
  end
 end
 burst(park,function(b) call("SyncMove",b) end)
 local chunks={}
 for _,row in ipairs(park) do chunks[#chunks+1]={Part=row.Part,Type="MeshPart"} end
 local fresh={}
 burstBy(chunks,math.max(6,math.ceil(#chunks/12)),function(b)
  local res=fcall("SyncTransform",b)
  if type(res)=="table" then for _,np in ipairs(res) do fresh[#fresh+1]=np end end
 end)
 local swapped={}
 for _,np in ipairs(fresh) do
  local id=spot[key(np.Position)]
  if id then P[id]=np swapped[id]=true end
 end
 for _,id in ipairs(kept) do
  if not swapped[id] then
   local p=P[id]
   if p and p.Parent==nil then P[id]=nil end
  end
 end
 move={}
 for i,d in ipairs(D) do local p=P[i] if p then move[#move+1]={Part=p,CFrame=d[2]} end end
end

